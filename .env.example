# Copy this file to .env.local and fill in real secrets in production.

# Auth
# Generate a strong secret (min 32 chars) with: openssl rand -base64 48
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
# Admin credentials used to seed the DB on first run / login.
ADMIN_EMAIL=admin@nexttogen.app
ADMIN_PASSWORD=admin123

# Public site URL (used for metadata/OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
