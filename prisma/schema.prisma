// NextToGen Institute — Database schema (SQLite)
// Admin panel isi DB ko manage karta hai: courses, blogs, testimonials,
// applications, messages, FAQs, subscribers aur site settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | EDITOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Course {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  tagline          String?
  category         String        @default("Computer")
  level            String        @default("Beginner")
  mode             String        @default("Offline") // Offline | Online | Hybrid
  duration         String
  fee              Int
  discountFee      Int?
  seats            Int           @default(30)
  startDate        DateTime?
  coverImage       String?
  shortDesc        String
  description      String // markdown
  syllabus         String        @default("[]") // JSON: [{ title, topics: string[] }]
  highlights       String        @default("[]") // JSON: string[]
  tools            String        @default("[]") // JSON: string[]
  eligibility      String?
  certification    String?
  placementSupport Boolean       @default(true)
  featured         Boolean       @default(false)
  published        Boolean       @default(true)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  applications     Application[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Application {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName    String?
  city          String?
  qualification String?
  preferredMode String?
  message       String?
  status        String   @default("NEW") // NEW | CONTACTED | ENROLLED | REJECTED
  notes         String?
  createdAt     DateTime @default(now())
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  content        String // markdown
  coverImage     String?
  author         String    @default("NextToGen Team")
  authorRole     String?
  category       String    @default("Career")
  tags           String    @default("[]") // JSON: string[]
  readMinutes    Int       @default(4)
  featured       Boolean   @default(false)
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  views          Int       @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String? // "Full Stack Developer @ Infosys" jaisa current role
  course    String? // jis course ka student tha
  rating    Int      @default(5)
  message   String
  avatar    String?
  city      String?
  year      String?
  videoUrl  String?
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  type      String   @default("CONTACT") // CONTACT | SUPPORT | PARTNER
  amount    Int?
  status    String   @default("NEW") // NEW | READ | REPLIED
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
